      }
      Schematic {
        Location      [1181, 225; 1807, 654]
        ZoomFactor    1.30957
        SliderPosition [0, 0]
        ShowBrowser   off
        BrowserWidth  100
        Component {
          Type          CScript
          Name          "PI_code_full1"
          Show          on
          Position      [320, 50]
          Direction     up
          Flipped       off
          LabelPosition north
          Parameter {
            Variable      "DialogGeometry"
            Value         "[768 215 789 611]"
            Show          off
          }
          Parameter {
            Variable      "NumInputs"
            Value         "9"
            Show          off
          }
          Parameter {
            Variable      "NumOutputs"
            Value         "1"
