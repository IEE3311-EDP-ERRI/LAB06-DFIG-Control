Plecs {
  Name          "1_DFIG_Ideal"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "14000e-3"
  Timeout       ""
  Solver        "auto"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "2"
  DatatypeInheritanceConflictMsg "1"
  ContSampleTimeConflictMsg "1"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
"%%%%%%%%%%%%%%%\nTs_control_DFIG = 1/10000 ; \nTc = 1/10000 ; \nfsw = 5000 ; "
"\n\n\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n%%"
"%% GRID \n\nV_g_peak = 690/sqrt(3)*sqrt(2); % Esto es amplitud fase-neutro \n"
"f_g = 50;\nomega_e = 2*pi*f_g ; \nw_g = omega_e ; \n\n\n%%%%%%%%%%%%%%%%%%%%%"
"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n%%%% MODELO DFIG \n\nP_n = 2e"
"6; % 2 MW! Potencia nominal \nn_p = 2; % pares de polos DFIG\nk_sr = 1/2.6; %"
" Turns ratio s/r\n\nL_ks = 0.12e-3; % leakage\nL_kr = 0.05e-3; % ya referido "
"a estator\nL_m = 2.9e-3 ; \nL_s = L_ks + L_m ; \nL_r = L_kr + L_m ; \n\nsigma"
" = 1 - L_m*L_m/(L_s*L_r) ; % coeficiente dispersion \nL_sigma = L_ks + L_kr ;"
" % inductancia dispersion \nL_sigmaR = L_r*sigma ;  % inductancia rotor afect"
"o a dispersion\n\nR_s = 0.022;\nR_r = 0.0018; % referido a estator \ngamma = "
"(L_ks + L_m)/L_m;\nR_R = (gamma^2)*R_r; % Rotor resistance in stator-flux ori"
"ented circuit\n\nJ_g = 75; \nJ_total_hs = J_g/0.1419*(0.6388 + 0.0114 + 0.080"
"6 + 0.1419); % total inertia of WT on high-speed side\n\n\n% Intial condition"
"s DFIG \nOmega_r_0 = 0.99*f_g*2*pi/n_p;\nPsi_sd_0 = 1e-3;\nPsi_sq_0 = 0;% V_g"
"peak/sqrt(2)*N_t2/N_t1/(2*pi*f_g);\n\n%Friction\nD_g = 0.01*P_n/((f_g*2*pi/n_"
"p)^2);\n\n%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%"
"\n%%%% CONTROLADORES\n\n\n% Dinamica estimador de flujo \nw_cutoff = 100; \n"
"\n% Control Irdq\n\nwc= 2*pi*200;  % Ancho de banda\nKp_Irdq = wc*L_sigmaR ; "
"\nKi_Irdq = wc*(R_r + R_s*L_m*L_m/(L_s*L_s)) ; \n\nvd_up_sat  =  100000 ; \nv"
"d_low_sat = -100000 ; \nvq_up_sat  =  100000 ; \nvq_low_sat = -100000 ; \n\n"
"\n% Control Q (Potencia Reactiva) \nI_Rd_max = 400*sqrt(2)*(1/1)*(1/gamma);\n"
"%I_Rd_max = 750*sqrt(2)*(1/k_sr)*(1/gamma);\n\nalpha_Q = 5;\nK_mc_iQ = alpha_"
"Q /(-3/2 * V_g_peak);\nK_mc_b_Q = 10; % anti-windup\n\n\n% Control P (Potenci"
"a activa) \nalpha_P = 5 ; \nK_mc_iP = alpha_P / ( -3/2 * n_p * L_m/L_s * V_g_"
"peak ) ; \n\n\n% Control de velocidad: we \nI_Rq_max = 1500 ; \nTe_max = 1000"
"0 ; \n\n% Speed control\nI_R_max = I_Rq_max ; \n% PI propio \nKp_wr = 2*0.85*"
"2*pi*0.6*J_total_hs ; \nKi_wr = (2*pi*0.6)^2 * J_total_hs ; \nB_wr  = Kp_wr* "
"0.5 ;   % Kp_wr* 0.161 ; \n\nwr = 157;% rad/s\n\n\n\n%%%%%%%%%%%%%%%%%%%%%%%%"
"%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%\n% GRID SIDE CONVE"
"RTER\n \n%V_gsc_peak = 690/sqrt(3)*sqrt(2); % Esto es amplitud fase-neutro \n"
"%Lg_eq = 2.0e-3 ; \n%Rg_eq = 10e-3  ;\n%R_precharge = 750 ; \n\nV_dclink = 12"
"50;\n% Limitations\n%P_nom  = 200e3;          % Potencia nominal\n%Ig_d_max ="
" P_nom * sqrt(2) * 1.15 / ( 3*V_gsc_peak/sqrt(2) ) ; \nVg_d_max = V_dclink*1."
"1 ; \n%Vg_d_max = V_gsc_peak*1.5 ; \n%R_dclink = V_dclink*V_dclink/P_nom ;"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
