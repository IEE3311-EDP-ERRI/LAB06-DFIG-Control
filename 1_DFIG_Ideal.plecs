        Component {
          Type          CScript
          Name          "PI_code_full"
          Show          on
          Position      [340, 120]
          Direction     up
          Flipped       off
          LabelPosition north
          Parameter {
            Variable      "DialogGeometry"
            Value         "[806 81 1064 926]"
            Show          off
          }
          Parameter {
