            Variable      "HighlightLevel"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "Declarations"
            Value         "#define LOWER_LIMIT ParamRealData(0, 0)\n"
"#define UPPER_LIMIT ParamRealData(1, 0)\n"
"double theta_k;\n"
"double theta_k_1;\n"
"double theta_abs;\n"
"double theta_rel;"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         "theta_k = 0; \n"
"theta_k_1 = 0;\n"
"theta_abs = 0;\n"
"theta_rel = 0;"
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "theta_k = theta_rel + (Input(0) - theta_abs);\n"
"\n"
"if (IsMajorStep)\n"
"{\n"
"\twhile (theta_k > UPPER_LIMIT)\n"
"   \t\ttheta_k -= (UPPER_LIMIT-LOWER_LIMIT);\n"
"\twhile (theta_k < LOWER_LIMIT)\n"
"   \t\ttheta_k += (UPPER_LIMIT-LOWER_LIMIT);\n"
"  theta_abs = Input(0);\n"
"  theta_rel = theta_k;\n"
"}\n"
"\n"
"ZCSignal(0) = theta_k-UPPER_LIMIT;\n"
"ZCSignal(1) = theta_k-LOWER_LIMIT;\n"
"\n"
"Output(0) = theta_k;\n"
            Show          off
          }
