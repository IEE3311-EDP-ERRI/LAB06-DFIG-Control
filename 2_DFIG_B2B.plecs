            Show          off
          }
          Parameter {
            Variable      "GnuExtensions"
            Value         "1"
            Show          off
          }
          Parameter {
            Variable      "RuntimeCheck"
            Value         "2"
            Show          off
          }
          Parameter {
            Variable      "HighlightLevel"
            Value         "0"
            Show          off
          }
          Parameter {
            Variable      "Declarations"
            Value         "#define W          Input(0)     // measured speed ["
"rad/s] (not used here, but handy)\n"
"#define P_MEAS     Input(1)     // measured power [W]\n"
"\n"
"#define P_OLD      DiscState(0) // last power\n"
"#define DIR        DiscState(1) // +1 or -1 (last perturbation direction)\n"
"#define WREF       DiscState(2) // current speed reference\n"
"\n"
"#define STEP       2        // rad/s per perturbation\n"
"#define EPS_P      10.0          // W deadband\n"
"#define WREF_MIN   0.0\n"
"#define WREF_MAX   400.0\n"
"\n"
"static double Wref_next;\n"
"static double Dir_next;"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         "P_OLD     = P_MEAS;\n"
"DIR       = +1.0;\n"
"WREF      = W;          // start from current speed\n"
"Wref_next = WREF;\n"
"Dir_next  = DIR;"
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "double dP = P_MEAS - P_OLD;\n"
"\n"
"double dir_new = DIR;   \n"
"if (dP >  EPS_P) {\n"
"    dir_new = DIR;\n"
"} else if (dP < -EPS_P) {\n"
"    dir_new = -DIR;\n"
"} else {\n"
"\tdir_new = 0;\n"
"}\n"
"\n"
"\n"
"Output(0) = W+dir_new*STEP;\n"
"Dir_next  = dir_new;\n"
"\n"
"\n"
"//double Wref_new = WREF;\n"
"//if (dP > EPS_P || dP < -EPS_P) {\n"
"//    Wref_new = WREF + dir_new * STEP;\n"
"//    if (Wref_new > WREF_MAX) Wref_new = WREF_MAX;\n"
"//    if (Wref_new < WREF_MIN) Wref_new = WREF_MIN;\n"
"//}\n"
"//Wref_next = Wref_new;\n"
            Show          off
          }
          Parameter {
            Variable      "UpdateFcn"
            Value         "P_OLD = P_MEAS;\n"
"WREF  = Wref_next;\n"
"DIR   = Dir_next;"
            Show          off
          }
          Parameter {
            Variable      "DerivativeFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "TerminateFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "StoreCustomStateFcn"
            Value         ""
            Show          off
          }
