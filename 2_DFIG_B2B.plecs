            Component {
              Type          CScript
              Name          "PI_code_full1"
              Show          on
              Position      [315, 60]
              Direction     up
              Flipped       off
              LabelPosition north
              Parameter {
                Variable      "DialogGeometry"
                Value         "[99 158 988 772]"
                Show          off
              }
              Parameter {
