      Schematic {
        Location      [1294, 229; 1920, 658]
        ZoomFactor    1.30957
        SliderPosition [0, 0]
        ShowBrowser   off
        BrowserWidth  100
        Component {
          Type          CScript
          Name          "PI_code_full1"
          Show          on
          Position      [340, 120]
          Direction     up
          Flipped       off
          LabelPosition north
          Parameter {
            Variable      "DialogGeometry"
            Value         "[99 158 988 772]"
            Show          off
          }
          Parameter {
            Variable      "NumInputs"
            Value         "9"
            Show          off
          }
          Parameter {
